{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Review"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "city": {
      "type": "string",
      "required": true,
      "regex": "Sydney|Melbourne"
    },
    "suburb": {
      "type": "string",
      "required": true,
      "regex": "^([A-Z][a-z]*\\s?)+$"
    },
    "drink": {
      "type": "string",
      "required": true,
      "regex": "^([A-Z][a-z]*\\s?)+$"
    },
    "temperature": {
      "type": "string",
      "required": true,
      "regex": "Hot|Cold"
    },
    "rating": {
      "type": "decimal",
      "min": 0,
      "max": 5
    },
    "hexCode": {
      "type": "string",
      "default": "000000",
      "required": true
    },
    "link": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
